# ALBATROSS frontend configuration.
#
# Local development does not need this file: the Vite dev server proxies /api to
# http://localhost:5000. Use it to point a build at a deployed API.

# Base URL of the ALBATROSS API, without the /api suffix.
# Example: https://albatross-backend.onrender.com
VITE_API_URL=

# Only used by the Vite dev proxy, if the API is not on localhost:5000.
# VITE_DEV_API_TARGET=http://localhost:5000