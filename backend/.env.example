# =============================================================
# ALBATROSS backend - environment variables
# Copy to backend/.env and fill in real values.
# NEVER commit .env.
# =============================================================

# --- Runtime ---
# development | production
APP_ENV=development

# --- Secrets (required in production) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=change-this-to-a-random-string-in-production
JWT_SECRET=change-this-to-a-random-string-in-production
JWT_EXPIRES_HOURS=168

# --- MongoDB (required) ---
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017
MONGODB_URI=
MONGODB_DATABASE=albatross

# --- LLM: Groq (required for answers) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Model choice: the API key is probed against the provider's model list on first
# use. If GROQ_MODEL is not reachable, ALBATROSS falls back through
# openai/gpt-oss-120b -> llama-3.3-70b-versatile -> openai/gpt-oss-20b -> qwen/qwen3.8-27b
# and reports the model actually in use at GET /api/health.
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
# Reasoning models spend part of this budget on hidden reasoning tokens
# before emitting the answer, so keep it above the answer length.
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MODEL_TIMEOUT_SECONDS=10
# low | medium | high - only sent to reasoning models (gpt-oss and friends).
LLM_REASONING_EFFORT=low
FOLLOWUP_MAX_TOKENS=400
# Turns of conversation history sent back to the model for follow-up questions.
CONVERSATION_HISTORY_TURNS=4

# --- Embeddings ---
# hashing                -> dependency-free deterministic feature hashing (default)
# sentence_transformers  -> real embeddings; requires `pip install sentence-transformers`
EMBEDDING_PROVIDER=hashing
# Only used when EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=1024

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_CHARS=30

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=40
MAX_TOP_K=20
RRF_K=60
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5

# --- Uploads and file storage ---
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,txt,md,markdown,docx,csv

# --- Processing ---
# background -> run ingestion in a worker thread and return 202 immediately
# sync       -> process inside the request (used by the test suite)
PROCESSING_MODE=background

# --- CORS ---
# Comma-separated allow-list. Never use * in production.
# Example: https://albatross.vercel.app,https://albatross-git-main.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH=20
RATE_LIMIT_UPLOAD=30
RATE_LIMIT_CHAT=60
RATE_LIMIT_DEFAULT=300

# --- Logging ---
LOG_LEVEL=INFO

# --- Misc ---
MAX_PREVIEW_CHARS=20000
