# Copy to .env and fill in your local values.
# NEVER commit .env

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Retrieval/index defaults
EMBEDDING_DIM=512
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5

# Local data paths (Render overrides these with its persistent disk path)
DATA_DIR=/tmp/rag-assistant
UPLOAD_FOLDER=/tmp/rag-assistant/uploads

FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-random-string-in-production
CORS_ORIGINS=http://localhost:5173
MAX_FILE_SIZE_MB=50
